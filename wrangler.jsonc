{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watchguide-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /terms, /privacy, /refunds and /support are client-side routes in the SPA.
    "not_found_handling": "single-page-application",
    // Only the API proxies run the Worker; static files are served directly, without Worker requests.
    "run_worker_first": ["/api/*"]
  }
}
